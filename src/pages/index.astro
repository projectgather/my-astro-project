
---
import '../styles/home.css';
// Définir cette URL après le déploiement public d’AlgoLab.
const algolabDeploymentUrl = 'https://algo-labo.streamlit.app/';
const projects = [
  {
    number: "01",
    category: "VISUALISATION D’ALGORITHMES · APPLICATION INTERACTIVE",
    title: "AlgoLab",
    description:
      "Explorer les algorithmes de tri étape par étape, comparer leur fonctionnement et s’entraîner à son rythme dans une plateforme interactive.",
    status: algolabDeploymentUrl ? "En ligne" : "Non accessible en ligne",
    active: true,
    featured: true,
    features: [
      "Visualisation pas à pas de six algorithmes de tri",
      "Exercices et défis interactifs",
      "Suivi de progression par profil",
    ],
    tags: ["Python", "Streamlit", "SQLite", "Tests"],
  },
  {
    number: "02",
    category: "OUTIL PERSONNEL · WEB",
    title: "Suivi de candidatures",
    description:
      "Organiser les candidatures, suivre leur progression et conserver ses données localement.",
    status: "Prévu",
    tags: ["JavaScript", "Données", "Interface"],
  },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Portfolio d'un étudiant en informatique : projets, apprentissages et démarche de développement."
    />
    <meta name="theme-color" content="#0b0d16" />
    <title>Portfolio — Informatique & développement</title>
  </head>

  <body>
    <header class="site-header">
      <nav class="navigation container" aria-label="Navigation principale">
        <a class="brand" href="#accueil" aria-label="Accueil du portfolio">
          <span class="brand-mark">n.</span>
          <span class="brand-label">PORTFOLIO <span>/</span> INFORMATIQUE</span>
        </a>

        <div class="nav-links">
          <a href="#projets">Projets</a>
          <a href="#apropos">À propos</a>
          <a href="#contact">Contact</a>
        </div>

        <a class="availability" href="#contact">
          <span class="availability-dot"></span>
          Alternance · 2027
        </a>
      </nav>
    </header>

    <main>
      <section class="hero container" id="accueil">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="eyebrow-line"></span>
            ÉTUDIANT EN BUT INFORMATIQUE
          </p>

          <h1>
            Comprendre<br />
            le code.<br />
            <span>Construire</span><br />
            des solutions.
          </h1>

          <p class="hero-description">
            J'apprends à concevoir des programmes, à explorer les algorithmes
            et à transformer des idées en projets concrets.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projets">
              Découvrir mes projets <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#apropos">
              Mon parcours <span aria-hidden="true">↓</span>
            </a>
          </div>

          <div class="hero-meta">
            <span>01 — APPRENDRE</span>
            <span>02 — EXPÉRIMENTER</span>
            <span>03 — PROGRESSER</span>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="art-topline">
            <span>FIG. 001</span>
            <span>TRACES / LOGIQUE</span>
          </div>

          <svg
            class="algorithm-art"
            viewBox="0 0 440 460"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <pattern
                id="grid"
                width="28"
                height="28"
                patternUnits="userSpaceOnUse"
              >
                <path
                  d="M 28 0 L 0 0 0 28"
                  stroke="#AAA0FF"
                  stroke-opacity=".10"
                  stroke-width="1"
                />
              </pattern>
              <linearGradient id="trace" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#A99AFF" />
                <stop offset="100%" stop-color="#6F7FE8" />
              </linearGradient>
            </defs>

            <rect width="440" height="460" fill="url(#grid)" />

            <circle
              cx="220"
              cy="220"
              r="154"
              stroke="#A99AFF"
              stroke-opacity=".14"
              stroke-dasharray="3 8"
            />
            <circle
              cx="220"
              cy="220"
              r="112"
              stroke="#A99AFF"
              stroke-opacity=".2"
            />
            <circle
              cx="220"
              cy="220"
              r="66"
              stroke="#A99AFF"
              stroke-opacity=".25"
              stroke-dasharray="2 6"
            />

            <path
              d="M60 100 H130 V170 H220 V220 H310 V290 H380"
              stroke="url(#trace)"
              stroke-width="2"
            />
            <path
              d="M60 340 H145 V290 H220 V220 H290 V145 H380"
              stroke="#A99AFF"
              stroke-opacity=".6"
              stroke-width="1.5"
            />
            <path
              d="M130 170 L165 205 L220 220 L270 190 L310 145"
              stroke="#F3F1FF"
              stroke-opacity=".45"
              stroke-width="1.5"
              stroke-dasharray="4 5"
            />

            <g fill="#0B0D16" stroke="#A99AFF" stroke-width="2">
              <circle cx="60" cy="100" r="5" />
              <circle cx="130" cy="170" r="5" />
              <circle cx="220" cy="220" r="7" />
              <circle cx="310" cy="290" r="5" />
              <circle cx="380" cy="290" r="5" />
              <circle cx="60" cy="340" r="5" />
              <circle cx="145" cy="290" r="5" />
              <circle cx="310" cy="145" r="5" />
              <circle cx="380" cy="145" r="5" />
            </g>

            <circle cx="220" cy="220" r="15" fill="#A99AFF" fill-opacity=".14" />
            <circle cx="220" cy="220" r="3" fill="#F3F1FF" />

            <g fill="#B6B7C8" font-family="monospace" font-size="10">
              <text x="42" y="85">INPUT</text>
              <text x="321" y="311">OUTPUT</text>
              <text x="230" y="208">STEP_03</text>
              <text x="48" y="363">01</text>
              <text x="365" y="126">04</text>
            </g>
          </svg>

          <div class="art-bottomline">
            <span>ENTRÉE → TRANSFORMATION → SORTIE</span>
            <span>001 / 003</span>
          </div>
        </div>

        <div class="hero-index" aria-hidden="true">PORTFOLIO — 2026/27</div>
      </section>

      <section class="projects-section section container" id="projets">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              <span class="eyebrow-line"></span>
              SÉLECTION DE TRAVAUX
            </p>
            <h2>Des idées aux <span>projets.</span></h2>
          </div>
          <p class="section-note">
            Des projets conçus pour apprendre, expérimenter et progresser.
          </p>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class:list={["project-card", project.featured && "project-card-featured"]}>
              <div class="project-number">{project.number}</div>

              <div class="project-content">
                <p class="project-category">{project.category}</p>
                <h3>{project.title}</h3>
                <p class="project-description">{project.description}</p>

                {project.features && (
                  <ul class="project-features" aria-label="Fonctionnalités principales">
                    {project.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                )}

                <ul class="tag-list" aria-label="Technologies et thèmes">
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>

                {project.featured && (
                  
                <div class="project-action" id="algolab-deployment">
                  {algolabDeploymentUrl ? (
                    <a
                      class="button button-primary project-cta"
                      href={algolabDeploymentUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Découvrir AlgoLab <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <button class="button button-primary project-cta" type="button" disabled>
                      Découvrir AlgoLab
                    </button>
                  )}

                  <a
                    class="text-link project-source-link"
                    href="https://github.com/projectgather/algo-lab"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Consulter le code source d'AlgoLab sur GitHub (nouvel onglet)"
                  >
                    Voir le code source <span aria-hidden="true">↗</span>
                  </a>

                  <p class="deployment-note">
                    {algolabDeploymentUrl
                      ? "Application AlgoLab ouverte dans un nouvel onglet."
                      : "AlgoLab n’est pas encore accessible en ligne. Configurez PUBLIC_ALGOLAB_URL avec l’URL de déploiement pour activer ce bouton."}
                  </p>
                </div>

                )}
              </div>

              <div class="project-side">
                <span class:list={["project-status", project.active && "status-active"]}>
                  <span class="status-dot"></span>
                  {project.status}
                </span>
                {!project.featured && (
                  <span class="project-arrow" aria-hidden="true">↗</span>
                )}
              </div>
            </article>
          ))}
        </div>

        <p class="honesty-note">
          Ces projets sont présentés selon leur état réel : aucune démo ni
          fonctionnalité n'est annoncée comme terminée avant de l'être.
        </p>
      </section>

      <section class="about-section section" id="apropos">
        <div class="container about-grid">
          <div>
            <p class="eyebrow">
              <span class="eyebrow-line"></span>
              DÉMARCHE
            </p>
            <h2>Apprendre en<br /><span>construisant.</span></h2>
          </div>

          <div class="about-content">
            <p class="about-lead">
              Je suis étudiant en BUT Informatique et je développe
              progressivement mes compétences à travers les cours et des
              projets personnels.
            </p>

            <p>
              Ma démarche : comprendre le problème, concevoir une solution,
              écrire le code, tester le résultat et documenter ce que
              j'apprends.
            </p>

            <div class="principles">
              <div class="principle">
                <span class="principle-number">01</span>
                <div>
                  <h3>Comprendre</h3>
                  <p>Privilégier la logique et les explications au code copié sans recul.</p>
                </div>
              </div>
              <div class="principle">
                <span class="principle-number">02</span>
                <div>
                  <h3>Expérimenter</h3>
                  <p>Tester les idées, observer les résultats et corriger les erreurs.</p>
                </div>
              </div>
              <div class="principle">
                <span class="principle-number">03</span>
                <div>
                  <h3>Documenter</h3>
                  <p>Garder une trace des décisions, des limites et des apprentissages.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section section container" id="contact">
        <p class="eyebrow">
          <span class="eyebrow-line"></span>
          ET POUR LA SUITE ?
        </p>
        <h2>Construisons<br /><span>la prochaine étape.</span></h2>
        <p class="contact-description">
          Je prépare mon parcours vers une alternance en développement
          informatique pour la rentrée 2027.
        </p>

        <div class="contact-links">
        <a href="mailto:nathan.barrault88@gmail.com">
            <span>E-mail</span>
            <span>Me contacter ↗</span>
        </a>

        <a
            href="https://github.com/zemetsufasedra-crypto"
            target="_blank"
            rel="noreferrer"
        >
            <span>GitHub</span>
            <span>Voir mes projets ↗</span>
        </a>

        <a href="/cv.pdf" target="_blank" rel="noreferrer">
            <span>Curriculum vitæ</span>
            <span>Consulter mon CV ↗</span>
        </a>
        </div>

      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand footer-brand" href="#accueil">
          <span class="brand-mark">n.</span>
          <span class="brand-label">PORTFOLIO <span>/</span> INFORMATIQUE</span>
        </a>
        <p>Conçu pour apprendre. Construit pour progresser.</p>
        <a href="#accueil" class="back-top">Retour en haut ↑</a>
      </div>
    </footer>
  </body>
</html>
