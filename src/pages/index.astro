---
const title = "Portfolio — Développeur informatique";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio de développeur informatique en formation." />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">PORTFOLIO · INFORMATIQUE</p>
      <h1>Construire.<br />Comprendre.<br /><span>Améliorer.</span></h1>
      <p class="intro">
        Étudiant en informatique, je conçois des projets pour transformer
        mes connaissances en compétences concrètes.
      </p>
      <p class="status"><span class="dot"></span> Portfolio en construction</p>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #0b0d16;
    color: #f3f1ff;
    font-family: Inter, "Segoe UI", sans-serif;
  }

  main {
    width: min(900px, 100%);
    margin: 0 auto;
    padding: 15vh 28px 80px;
  }

  .eyebrow {
    color: #a99aff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  h1 {
    margin: 44px 0 24px;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }

  h1 span {
    color: #a99aff;
  }

  .intro {
    max-width: 540px;
    color: #b6b7c8;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 42px;
    color: #d4d1e5;
    font-size: 0.9rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #a99aff;
    box-shadow: 0 0 12px #a99aff80;
  }
</style>